From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Tue, 7 Jul 2026 23:14:53 +0200
Subject: do a dirty load of current env vars so that plasma mobile does not
 override

---
 bin/startplasmamobile.in | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/bin/startplasmamobile.in b/bin/startplasmamobile.in
index 9c4c994de124..96b9ac0a6d10 100755
--- a/bin/startplasmamobile.in
+++ b/bin/startplasmamobile.in
@@ -16,8 +16,29 @@ export QT_QUICK_CONTROLS_MOBILE=true
 export PLASMA_INTEGRATION_USE_PORTAL=1
 export PLASMA_PLATFORM=phone:handset
 
+# Load distro Plasma defaults before adding the mobile overlay. Fedora's
+# kde-settings profile is added here, and Plasma skips it if XDG_CONFIG_DIRS is
+# already set.
+[ -f /etc/xdg/plasma-workspace/env/env.sh ] && . /etc/xdg/plasma-workspace/env/env.sh
+
+if [ -n "$XDG_CONFIG_HOME" ]; then
+	config_home="$XDG_CONFIG_HOME"
+else
+	config_home="$HOME/.config"
+fi
+
+if [ -n "$XDG_CONFIG_DIRS" ]; then
+	config_dirs="$XDG_CONFIG_DIRS"
+else
+	config_dirs="/etc/xdg"
+fi
+
+if [ -d "$config_home/kdedefaults" ]; then
+	config_dirs="$config_home/kdedefaults:$config_dirs"
+fi
+
 # Set ~/.config/plasma-mobile/... as location for default mobile configs (i.e. envmanager generated)
-export XDG_CONFIG_DIRS="$HOME/.config/plasma-mobile:/etc/xdg:$XDG_CONFIG_DIRS"
+export XDG_CONFIG_DIRS="$config_home/plasma-mobile:$config_dirs"
 
 # if coredumpd knows about the dumps, make sure drkonqi catches them
 if grep -q '/systemd-coredump' /proc/sys/kernel/core_pattern

