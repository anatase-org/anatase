From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Sun, 9 Aug 2026 02:54:01 +0200
Subject: catch sighup so plasmalogin does not crash

---
 src/helper/HelperApp.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/helper/HelperApp.cpp b/src/helper/HelperApp.cpp
index 61553d39e07c..acaacb9ac37d 100644
--- a/src/helper/HelperApp.cpp
+++ b/src/helper/HelperApp.cpp
@@ -44,9 +44,10 @@ HelperApp::HelperApp(int &argc, char **argv)
 {
     qInstallMessageHandler(HelperMessageHandler);
     auto sig = KSignalHandler::self();
+    sig->watchSignal(SIGHUP);
     sig->watchSignal(SIGTERM);
     QObject::connect(sig, &KSignalHandler::signalReceived, m_session, [](int s) {
-        if (s == SIGTERM) {
+        if (s == SIGHUP || s == SIGTERM) {
             QCoreApplication::instance()->exit(-1);
         }
     });
