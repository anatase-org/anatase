+namespace
+{
+struct NextSessionRequest {
+    QString user;
+    Session session;
+};
+
+std::optional<NextSessionRequest> takeNextSessionRequest()
+{
+    const QString requestPath = QStringLiteral(RUNTIME_DIR) + QStringLiteral("/next-session.conf");
+    if (!QFile::exists(requestPath)) {
+        return std::nullopt;
+    }
+
+    const QString claimedPath = requestPath + QStringLiteral(".consumed");
+    QFile::remove(claimedPath);
+    if (!QFile::rename(requestPath, claimedPath)) {
+        qWarning() << "Unable to claim next session request" << requestPath;
+        return std::nullopt;
+    }
+
+    QString user;
+    QString sessionName;
+    {
+        KConfig requestConfig(claimedPath, KConfig::SimpleConfig);
+        const KConfigGroup autologinGroup(&requestConfig, QStringLiteral("Autologin"));
+        user = autologinGroup.readEntry(QStringLiteral("User"));
+        sessionName = autologinGroup.readEntry(QStringLiteral("Session"));
+    }
+
+    if (!QFile::remove(claimedPath)) {
+        qWarning() << "Unable to remove consumed next session request" << claimedPath;
+    }
+
+    if (user.isEmpty() || sessionName.isEmpty()) {
+        qWarning() << "Next session request is missing its user or session";
+        return std::nullopt;
+    }
+
+    if (!getpwnam(qPrintable(user))) {
+        qWarning() << "Unable to find user from next session request" << user;
+        return std::nullopt;
+    }
+
+    Session session = Session::create(Session::WaylandSession, sessionName);
+    if (!session.isValid()) {
+        session = Session::create(Session::X11Session, sessionName);
+    }
+    if (!session.isValid()) {
+        qWarning() << "Unable to find session from next session request" << sessionName;
+        return std::nullopt;
+    }
+
+    return NextSessionRequest{user, session};
+}
