#!/bin/sh
set -eu

#
# Create an empty blowfish wallet for users without passwords
# Some would say it is insecure, but if they didn't set a password
# Well, it's better than to get kwallet on their face
#


# Check the user has no password
user="${USER:-$(id -un)}"
status="$(passwd -S "${user}" 2>/dev/null | awk '{ print $2 }' || true)"
if [ "${status}" != "NP" ]; then
    exit 0
fi

data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
kwalletrc="${config_home}/kwalletrc"

# If kwallet has been disabled, don't do anything
if [ "$(kreadconfig6 --file "${kwalletrc}" --group Wallet --key Enabled --default true)" = "false" ]; then
    exit 0
fi

# If the wallet exists, don't do anything
default_wallet="$(kreadconfig6 --file "${kwalletrc}" --group Wallet --key "Default Wallet" --default kdewallet)"
wallet="$(kreadconfig6 --file "${kwalletrc}" --group Wallet --key "Local Wallet" --default "${default_wallet}")"
case "${wallet}" in
    ""|*/*)
        exit 0
        ;;
esac

wallet_dir="${data_home}/kwalletd"
wallet_file="${wallet_dir}/${wallet}.kwl"
salt_file="${wallet_dir}/${wallet}.salt"

if [ -e "${wallet_file}" ]; then
    exit 0
fi

install -dm0700 "${wallet_dir}"
install -dm0755 "${config_home}"

# Create a hash for no password
password_hash=$(python3 - "${salt_file}" <<'PY'
import hashlib
import os
import sys

salt_path = sys.argv[1]
if os.path.exists(salt_path) and os.path.getsize(salt_path) == 56:
    with open(salt_path, "rb") as salt_file:
        salt = salt_file.read()
else:
    salt = os.urandom(56)
    fd = os.open(salt_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as salt_file:
        salt_file.write(salt)

password_hash = hashlib.pbkdf2_hmac("sha512", b"", salt, 50000, 56)
print("[" + ", ".join(f"byte 0x{byte:02x}" for byte in password_hash) + "]")
PY
)

# Create the wallet with that hash
gdbus call --session \
    --dest org.kde.secretservicecompat \
    --object-path /ksecretd \
    --method org.kde.KWallet.pamOpen \
    "${wallet}" "${password_hash}" 0 >/dev/null 2>&1 || exit 0
