#!/usr/bin/python3

import hashlib
import os
import pwd
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path


HASH_SIZE = 56
ITERATIONS = 50_000
START_TIMEOUT = 10
KSECRET_PATH = "/usr/bin/ksecretd"


def fail(message):
    print(f"anatase-empty-password-kwallet: {message}", file=sys.stderr)
    raise SystemExit(1)


def password_status(user):
    result = subprocess.run(
        ["passwd", "-S", user],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        fail(result.stderr.strip() or f"could not read password status for {user}")

    fields = result.stdout.split()
    if len(fields) < 2:
        fail(f"unexpected password status for {user}: {result.stdout.strip()}")
    return fields[1]


def read_wallet_config(config, key, default):
    result = subprocess.run(
        [
            "kreadconfig6",
            "--file",
            str(config),
            "--group",
            "Wallet",
            "--key",
            key,
            "--default",
            default,
        ],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        fail(result.stderr.strip() or f"could not read {key} from {config}")
    return result.stdout.rstrip("\n")


def password_hash(salt_file):
    try:
        if salt_file.is_file() and salt_file.stat().st_size == HASH_SIZE:
            salt = salt_file.read_bytes()
        else:
            salt = os.urandom(HASH_SIZE)
            fd = os.open(salt_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "wb") as output:
                output.write(salt)
    except OSError as error:
        fail(f"could not create or read {salt_file}: {error}")

    return hashlib.pbkdf2_hmac(
        "sha512", b"", salt, ITERATIONS, dklen=HASH_SIZE
    )


def write_all(fd, contents):
    offset = 0
    while offset < len(contents):
        offset += os.write(fd, contents[offset:])


def stop_child(pid):
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        os.waitpid(pid, 0)
    except ChildProcessError:
        pass


def start_ksecretd(wallet_file, key):
    runtime_dir = Path(
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    )
    if not runtime_dir.is_dir():
        fail(f"runtime directory does not exist: {runtime_dir}")

    socket_path = runtime_dir / f"anatase-kwallet-{os.getpid()}.socket"
    hash_read, hash_write = os.pipe()
    environment_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)

    try:
        environment_socket.bind(str(socket_path))
        os.chmod(socket_path, 0o600)
        environment_socket.listen(1)
        os.set_inheritable(hash_read, True)
        os.set_inheritable(environment_socket.fileno(), True)

        child_environment = os.environ.copy()
        child_environment["PAM_KWALLET5_LOGIN"] = str(socket_path)

        pid = os.fork()
        if pid == 0:
            try:
                os.close(hash_write)
                arguments = [
                    KSECRET_PATH,
                    "--pam-login",
                    str(hash_read),
                    str(environment_socket.fileno()),
                ]
                os.execve(KSECRET_PATH, arguments, child_environment)
            except BaseException as error:
                print(
                    f"anatase-empty-password-kwallet: could not start "
                    f"{KSECRET_PATH}: {error}",
                    file=sys.stderr,
                )
                os._exit(127)

        os.close(hash_read)
        environment_socket.close()

        try:
            write_all(hash_write, key)
        finally:
            os.close(hash_write)

        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(START_TIMEOUT)
            client.connect(str(socket_path))
            for name, value in child_environment.items():
                if "\n" not in name and "\n" not in value:
                    client.sendall(f"{name}={value}\n".encode())

        deadline = time.monotonic() + START_TIMEOUT
        while time.monotonic() < deadline:
            if wallet_file.is_file():
                return
            exited, status = os.waitpid(pid, os.WNOHANG)
            if exited:
                fail(f"{KSECRET_PATH} exited before creating the wallet: {status}")
            time.sleep(0.1)

        stop_child(pid)
        fail(f"timed out waiting for {wallet_file}")
    except SystemExit:
        raise
    except (OSError, TimeoutError) as error:
        if "pid" in locals() and pid:
            stop_child(pid)
        fail(f"could not start KWallet through the PAM handshake: {error}")
    finally:
        try:
            os.close(hash_read)
        except OSError:
            pass
        try:
            os.close(hash_write)
        except OSError:
            pass
        environment_socket.close()
        try:
            socket_path.unlink()
        except FileNotFoundError:
            pass


def main():
    user = pwd.getpwuid(os.getuid()).pw_name
    if password_status(user) != "NP":
        return

    home = Path.home()
    data_home = Path(os.environ.get("XDG_DATA_HOME", home / ".local/share"))
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
    kwallet_config = config_home / "kwalletrc"

    if read_wallet_config(kwallet_config, "Enabled", "true") == "false":
        return

    default_wallet = read_wallet_config(
        kwallet_config, "Default Wallet", "kdewallet"
    )
    wallet = read_wallet_config(
        kwallet_config, "Local Wallet", default_wallet
    )
    if not wallet or Path(wallet).name != wallet:
        fail(f"invalid local wallet name: {wallet!r}")

    wallet_dir = data_home / "kwalletd"
    wallet_file = wallet_dir / f"{wallet}.kwl"
    if wallet_file.exists():
        return

    wallet_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    config_home.mkdir(mode=0o755, parents=True, exist_ok=True)
    key = password_hash(wallet_dir / f"{wallet}.salt")
    start_ksecretd(wallet_file, key)


if __name__ == "__main__":
    main()
