From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Sat, 8 Aug 2026 13:49:30 +0200
Subject: detect nonstandard system battery names

---
 main.rs | 29 +++++++++++++++++++----------
 1 file changed, 19 insertions(+), 10 deletions(-)

diff --git a/main.rs b/main.rs
index 5bfe2705af7e..fa73f85e58de 100644
--- a/main.rs
+++ b/main.rs
@@ -196,20 +196,29 @@ fn main() {
 	println!("Warning: Could not find device for AC/Mains, some functionality might be missing or not accurate.");
     }
 
-    // Try to find reasonable BATn to use (stop at the first),
-    // otherwise it's a system without battery -- bail-out
+    // Find the first system battery. Battery power supplies are not required to
+    // use BATn names; for example, some devices expose their battery as BATT.
     let mut path_bat = PathBuf::from("");
-    for i in 0..9 {
-	let path_string_test_base = format!("/sys/class/power_supply/BAT{i}");
-	let path_string_test = format!("{path_string_test_base}/type");
-	let path_bat_test = Path::new(&path_string_test);
-	if ! path_bat_test.exists() {
+    let power_supply_paths = fs::read_dir("/sys/class/power_supply/").unwrap();
+    for ps in power_supply_paths {
+	let path_string_test_base = ps.unwrap().path();
+	let path_bat_test = path_string_test_base.join("type");
+	if !path_bat_test.exists() {
 	    continue;
 	}
 
-	let path_bat_test_type: String = fs::read_to_string(path_bat_test).expect("Cannot read path");
-	if path_bat_test_type.contains("Battery") {
-	    path_bat = PathBuf::from(path_string_test_base);
+	let path_bat_test_type = fs::read_to_string(path_bat_test).expect("Cannot read path");
+	if path_bat_test_type.trim() == "Battery" {
+	    // Ignore peripheral batteries when the kernel identifies their scope.
+	    let path_scope = path_string_test_base.join("scope");
+	    let is_device_battery = fs::read_to_string(path_scope)
+		.map(|scope| scope.trim() == "Device")
+		.unwrap_or(false);
+	    if is_device_battery {
+		continue;
+	    }
+
+	    path_bat = path_string_test_base;
 	    println!("Info: Init: Found battery: '{}'", path_bat.display());
 	    break;
 	}
