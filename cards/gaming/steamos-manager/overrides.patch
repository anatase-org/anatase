+async fn get_hhd_status() -> HhdStatus {
+    let output = Command::new(HHD_CMD)
+        .arg("steamos-gpu")
+        .arg("get")
+        .output()
+        .await;
+
+    if output.is_err() {
+        return HhdStatus::Inactive;
+    }
+
+    let code = output.unwrap().status.code().unwrap_or(0);
+    match code {
+        1 => HhdStatus::Inactive,
+        2 => HhdStatus::Conflicts,
+        _ => HhdStatus::Active,
+    }
+}
