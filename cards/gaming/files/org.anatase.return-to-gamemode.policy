<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Anatase</vendor>
  <action id="org.anatase.return-to-gamemode">
    <description>Return to Gamemode</description>
    <message>Authentication is required to return to Gamemode</message>
    <icon_name>gamemode</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/return-to-gamemode-helper</annotate>
  </action>
</policyconfig>
