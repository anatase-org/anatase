#!/bin/bash

if (( $# != 0 )); then
    echo "Usage: ${0##*/}" >&2
    exit 2
fi

# D-Bus activated portal services and the session service inherit their
# environment from the user manager.
export XDG_SESSION_TYPE=x11
export DESKTOP_SESSION=gamemode
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=gamemode
export XDG_DESKTOP_PORTAL_DIR=/usr/share/xdg-desktop-portal/gamescope-portals

# A generic browser preference in the user's mimeapps.list takes precedence
# over system gamescope defaults. Install a desktop-specific user default so
# links use Steam's visible browser without changing the Plasma preference.
# Preserve any explicit Gamemode-specific configuration, including symlinks.
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
if [[ ! -e $config_home/gamescope-mimeapps.list && ! -L $config_home/gamescope-mimeapps.list ]]; then
    mkdir -p "$config_home"
    ln -s /usr/share/applications/gamescope-mimeapps.list \
        "$config_home/gamescope-mimeapps.list"
fi

systemctl --user import-environment \
    DESKTOP_SESSION \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_ID \
    XDG_SESSION_TYPE \
    XDG_DESKTOP_PORTAL_DIR

service=anatase-gamemode.service
terminating=
trap 'terminating=1' HUP INT TERM

# A signal interrupts Bash's wait builtin. Run cleanup from the mainline so the
# session remains alive until the service has stopped.
systemctl --user --wait start "$service" &
wait "$!"
status=$?

systemctl --user stop "$service" 2>/dev/null || true
flatpak kill org.anatase.Steam || true

# Teardown services that use the overrides after Gamemode has stopped.
systemctl --user stop \
    flatpak-portal.service \
    flatpak-session-helper.service \
    xdg-desktop-portal.service || true

systemctl --user unset-environment \
    DESKTOP_SESSION \
    DISPLAY \
    IBUS_ADDRESS \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_DESKTOP_PORTAL_DIR \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_ID \
    XDG_SESSION_TYPE || true

if [[ -n $terminating ]]; then
    exit 143
fi

# Plasma Login reserves status 1 for authentication failures. Map a failed
# session payload to its HELPER_SESSION_ERROR status so it starts the greeter.
(( status == 0 )) || status=2
exit "$status"
