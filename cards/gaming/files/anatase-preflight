def install_error_message(output):
    message = output.casefold()
    if any(
        phrase in message
        for phrase in (
            "could not resolve",
            "couldn't resolve",
            "connection refused",
            "connection reset",
            "network is unreachable",
            "name or service not known",
            "temporary failure in name resolution",
            "timed out",
            "timeout was reached",
            "tls connection",
        )
    ):
        return _(
            "Steam could not be downloaded\nGo to desktop mode and check your internet connection"
        )
    if any(
        phrase in message
        for phrase in ("no space left on device", "not enough disk space", "disk full")
    ):
        return _(
            "There is not enough free storage to install Steam"
        )
    return _("Steam could not be installed\nTry installing it from the Discover App store")


