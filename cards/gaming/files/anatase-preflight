def crc16_for_byte(byte):
    crc = 0
    for _index in range(8):
        if (byte ^ crc) & 1:
            crc = (crc >> 1) ^ 0xA001
        else:
            crc >>= 1
        byte >>= 1
    return crc


def sdl_crc16(crc, data):# -> Any:
    for byte in data:
        crc = crc16_for_byte(crc ^ byte) ^ (crc >> 8)
    return crc


def create_joystick_guid(device):
    """Create the Linux SDL GUID used by the controller mapping database."""
    info = device.info
    name = (device.name or "").encode()
    guid = bytearray(16)
    guid[0:2] = info.bustype.to_bytes(2, "little")
    guid[2:4] = sdl_crc16(0, name).to_bytes(2, "little")
    if info.vendor:
        guid[4:6] = info.vendor.to_bytes(2, "little")
        guid[8:10] = info.product.to_bytes(2, "little")
        guid[12:14] = info.version.to_bytes(2, "little")
    else:
        guid[4:16] = name[:12].ljust(12, b"\0")
    return guid


def parse_sdl_mappings(lines):
    mappings = {}
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        try:
            guid_text, _name, *bindings = line.split(",")
            if guid_text == "xinput":
                continue
            guid = bytes.fromhex(guid_text)
            if len(guid) != 16:
                continue

            platform = None
            ab = {}
            for binding in bindings:
                if ":" not in binding:
                    continue
                key, value = binding.split(":", 1)
                if key == "platform":
                    platform = value.strip().casefold()
                elif key in ("a", "b") and re.fullmatch(r"b\d+", value):
                    ab[key] = int(value[1:])
            if platform not in (None, "linux") or not ab:
                continue
            mappings[guid] = ab
        except (TypeError, ValueError):
            continue
    return mappings


def load_sdl_mappings():
    mappings = {}
    try:
        with open(CONTROLLER_DB_PATH, encoding="utf-8") as database:
            mappings.update(parse_sdl_mappings(database))
    except OSError as error:
        print(f"Could not read {CONTROLLER_DB_PATH}: {error}", file=sys.stderr)

    environment = os.environ.get("SDL_GAMECONTROLLERCONFIG", "")
    mappings.update(parse_sdl_mappings(environment.splitlines()))
    return mappings


def _event_codes(capabilities, event_type):
    codes = []
    for value in capabilities.get(event_type, ()):
        code = value[0] if isinstance(value, tuple) else value
        codes.append(code)
    return sorted(codes)


def _mapped_guid(guid, mappings):
    candidate = bytearray(guid)
    candidate[2:4] = b"\0\0"
    binding = mappings.get(bytes(candidate))
    if binding is not None:
        return binding
    candidate[12:14] = b"\0\0"
    return mappings.get(bytes(candidate))


def controller_ab_mapping(device, mappings):
    key_codes = _event_codes(device.capabilities(), ecodes.EV_KEY)
    mapping = {}

    # This follows the SDL GUID and joydev button-index approach used by
    # hhd/plugins/overlay/sdl.py, without importing or depending on HHD APIs.
    binding = _mapped_guid(create_joystick_guid(device), mappings)
    if binding:
        before_joystick = [code for code in key_codes if code < ecodes.BTN_JOYSTICK]
        after_joystick = [code for code in key_codes if code >= ecodes.BTN_JOYSTICK]
        joypad_buttons = after_joystick + before_joystick
        for action in ("a", "b"):
            index = binding.get(action)
            if index is not None and index < len(joypad_buttons):
                mapping[joypad_buttons[index]] = action

    if "a" not in mapping.values() and ecodes.BTN_SOUTH in key_codes:
        mapping[ecodes.BTN_SOUTH] = "a"
    if "b" not in mapping.values() and ecodes.BTN_EAST in key_codes:
        mapping[ecodes.BTN_EAST] = "b"
    return mapping


class ControllerListener:
    def __init__(self, callback):
        self.callback = callback
        self.mappings = load_sdl_mappings()
        self.devices = {}
        self.scan_source = GLib.timeout_add_seconds(2, self._scan)
        self._scan()

    def _scan(self):
        available = set(list_devices())
        for path in set(self.devices) - available:
            self._remove(path)
        for path in available - set(self.devices):
            self._add(path)
        return GLib.SOURCE_CONTINUE

    def _add(self, path):
        try:
            device = InputDevice(path)
            mapping = controller_ab_mapping(device, self.mappings)
            if not mapping:
                device.close()
                return
            source = GLib.io_add_watch(
                device.fd,
                GLib.PRIORITY_DEFAULT,
                GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                self._read,
                path,
            )
            self.devices[path] = (device, mapping, source)
        except (OSError, PermissionError) as error:
            print(f"Could not monitor controller {path}: {error}", file=sys.stderr)

    def _remove(self, path, remove_source=True):
        record = self.devices.pop(path, None)
        if not record:
            return
        device, _mapping, source = record
        if remove_source:
            GLib.source_remove(source)
        device.close()

    def _read(self, _fd, condition, path):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self._remove(path, remove_source=False)
            return GLib.SOURCE_REMOVE
        record = self.devices.get(path)
        if not record:
            return GLib.SOURCE_REMOVE
        device, mapping, _source = record
        try:
            for event in device.read():
                if event.type == ecodes.EV_KEY and event.value == 1:
                    action = mapping.get(event.code)
                    if action:
                        self.callback(action)
        except BlockingIOError:
            pass
        except OSError as error:
            print(f"Controller {path} stopped responding: {error}", file=sys.stderr)
            self._remove(path, remove_source=False)
            return GLib.SOURCE_REMOVE
        return GLib.SOURCE_CONTINUE

    def close(self):
        if self.scan_source:
            GLib.source_remove(self.scan_source)
            self.scan_source = None
        for path in list(self.devices):
            self._remove(path)


