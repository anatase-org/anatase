    def px(value):
        return f"{value * scale_factor:.2f}px"

    return f"""
window, .page {{
    background-color: #000000;
    color: #ffffff;
}}

.page {{
    padding: {px(32)};
}}

label {{
    color: #ffffff;
    font-size: {px(22)};
}}

.title {{
    font-size: {px(34)};
    font-weight: 700;
}}

.status {{
    font-size: {px(28)};
    font-weight: 600;
}}

.error {{
    color: #ffb4ab;
}}

button {{
    min-width: {px(130)};
    min-height: {px(40)};
    padding: {px(8)} {px(22)};
    font-size: {px(22)};
    font-weight: 600;
}}

progressbar {{
    min-width: {px(420)};
}}

progressbar trough,
progressbar progress {{
    min-height: {px(10)};
}}

progressbar trough {{
    background-color: #292929;
}}

progressbar progress {{
    background-color: #ffffff;
}}
"""


class Preflight(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.anatase.Preflight",
            flags=Gio.ApplicationFlags.NON_UNIQUE,
        )
        self.window = None
        self.listener = None
        self.action_a = None
        self.action_b = None
        self.action_pending = False
        self.install_process = None
        self.install_pulse_source = None
        self.result = 1
        self.qr_surface = None
        self.scale_factor = 1.0

    def do_activate(self):
        monitors = Gdk.Display.get_default().get_monitors()
        if monitors.get_n_items():
            display_width = monitors.get_item(0).get_geometry().width
        else:
            display_width = UI_BASE_WIDTH
        self.scale_factor = calculate_ui_scale(display_width)

        provider = Gtk.CssProvider()
        provider.load_from_string(make_css(self.scale_factor))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title(_("Steam® setup"))
        self.window.set_decorated(False)
        self.window.connect("realize", self._register_with_gamescope)
        self.window.fullscreen()

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self._key_pressed)
        self.window.add_controller(keys)
        self.listener = ControllerListener(self.activate_action)

        if steam_installed():
            self.show_final_page()
        else:
            self.show_agreement()
        self.window.present()

    def _register_with_gamescope(self, window):
        """Make this window Steam's base layer while Steam is not running."""
        try:
            xid = GdkX11.X11Surface.get_xid(window.get_surface())
            display = XDisplay(os.environ.get("DISPLAY"))
            xwindow = display.create_resource_object("window", xid)
            xwindow.change_property(
                display.intern_atom("STEAM_GAME"),
                Xatom.CARDINAL,
                32,
                [STEAM_APP_ID],
            )
            display.screen().root.change_property(
                display.intern_atom("GAMESCOPECTRL_BASELAYER_APPID"),
                Xatom.CARDINAL,
                32,
                [STEAM_APP_ID],
            )
            display.sync()
            display.close()
        except Exception as error:
            print(f"Could not register the preflight window with Gamescope: {error}", file=sys.stderr)
            self.result = 1
            self.quit()

    def do_shutdown(self):
        self._stop_install_pulse()
        if self.listener:
            self.listener.close()
            self.listener = None
        Gio.Application.do_shutdown(self)

    def _page(self):
        page = Gtk.CenterBox(orientation=Gtk.Orientation.VERTICAL)
        page.add_css_class("page")
        page.set_halign(Gtk.Align.FILL)
        page.set_valign(Gtk.Align.FILL)
        page.set_hexpand(True)
        page.set_vexpand(True)
        return page

    def _center(self, widget):
        widget.set_halign(Gtk.Align.CENTER)
        widget.set_valign(Gtk.Align.CENTER)
        return widget

    def _scale(self, value):
        return round(value * self.scale_factor)

    def _label(self, text, css_class=None):
        label = Gtk.Label(label=text)
        label.set_wrap(True)
        label.set_justify(Gtk.Justification.CENTER)
        label.set_max_width_chars(72)
        label.set_halign(Gtk.Align.CENTER)
        if css_class:
            label.add_css_class(css_class)
        return label

    def _buttons(self, left_text, left_action, right_text, right_action):
        row = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=self._scale(42),
        )
        row.set_halign(Gtk.Align.CENTER)

        left = Gtk.Button(label=left_text)
        left.connect("clicked", lambda _button: self.activate_action(left_action))
        row.append(left)

        right = Gtk.Button(label=right_text)
        right.connect("clicked", lambda _button: self.activate_action(right_action))
        row.append(right)
        right.grab_focus()
        return row

    def _set_page(self, page, action_a=None, action_b=None):
        self._stop_install_pulse()
        self.action_a = action_a
        self.action_b = action_b
        self.action_pending = False
        self.window.set_child(page)

    def _stop_install_pulse(self):
        if self.install_pulse_source is not None:
            GLib.source_remove(self.install_pulse_source)
            self.install_pulse_source = None

    def _pulse_install_progress(self, progress):
        progress.pulse()
        return GLib.SOURCE_CONTINUE

    def _key_pressed(self, _controller, keyval, _keycode, _state):
        if keyval in (Gdk.KEY_a, Gdk.KEY_A):
            self.activate_action("a")
            return True
        if keyval in (Gdk.KEY_b, Gdk.KEY_B):
            self.activate_action("b")
            return True
        return False

    def activate_action(self, action):
        if self.action_pending:
            return
        callback = self.action_a if action == "a" else self.action_b
        if callback is None:
            return
        self.action_pending = True
        callback()

    def _qr_draw(self, _area, context, width, height):
        if self.qr_surface is None:
            try:
                self.qr_surface = cairo.ImageSurface.create_from_png(QR_PATH)
            except (cairo.Error, OSError) as error:
                print(f"Could not load QR code {QR_PATH}: {error}", file=sys.stderr)
                return

        source_width = self.qr_surface.get_width()
        source_height = self.qr_surface.get_height()
        target = min(width, height)
        if target <= 0:
            return
        x = (width - target) / 2
        y = (height - target) / 2

        context.save()
        context.translate(x, y)
        context.scale(target / source_width, target / source_height)
        mask = cairo.SurfacePattern(self.qr_surface)
        mask.set_filter(cairo.FILTER_NEAREST)
        context.set_source_rgb(1, 1, 1)
        context.mask(mask)
        context.restore()

    def _qr_size(self):
        monitors = Gdk.Display.get_default().get_monitors()
        if monitors.get_n_items():
            height = monitors.get_item(0).get_geometry().height
        else:
            height = 1080
        return max(1, round(height * QR_SCREEN_FRACTION))

    def show_agreement(self):
        page = self._page()
        content = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=self._scale(14),
        )
        self._center(content)

        content.append(self._label(_("Steam® Client Installation"), "title"))

        content.append(
            self._label(
                _(
                    "Currently, gamemode only supports the Valve Software Steam® storefront"
                )
            )
        )
        content.append(
            self._label(
                _(
                    "By installing Steam®, you accept the Steam Subscriber Agreement (QR Code)"
                )
            )
        )

        # QR Code
        qr = Gtk.DrawingArea()
        qr_size = self._qr_size()
        qr.set_content_width(qr_size)
        qr.set_content_height(qr_size)
        qr.set_draw_func(self._qr_draw)
        self._center(qr)
        content.append(qr)

        content.append(
            self._buttons(_("Exit [B]"), "b", _("Install [A]"), "a")
        )
        page.set_center_widget(content)
        self._set_page(page, self.start_install, self.exit_requested)

    def show_installing(self):
        page = self._page()
        content = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=self._scale(24),
        )
        self._center(content)
        content.append(
            self._label(_("Installing Steam®"), "status")
        )
        progress = Gtk.ProgressBar()
        progress.set_pulse_step(0.08)
        self._center(progress)
        content.append(progress)
        page.set_center_widget(content)
        self._set_page(page)
        progress.pulse()
        self.install_pulse_source = GLib.timeout_add(
            100, self._pulse_install_progress, progress
        )

    def start_install(self):
        self.show_installing()
        flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
        try:
            self.install_process = Gio.Subprocess.new(
                [
                    "flatpak",
                    "install",
                    "--system",
                    "--assumeyes",
                    "--noninteractive",
                    "anatase",
                    APP_ID,
                ],
                flags,
            )
            self.install_process.communicate_utf8_async(
                None, None, self._install_complete
            )
        except GLib.Error as error:
            output = str(error)
            print(f"Steam installation failed: {output}", file=sys.stderr)
            self.show_install_error(output)

    def _install_complete(self, process, result):
        try:
            _communicated, stdout, _stderr = process.communicate_utf8_finish(result)
            output = stdout or ""
            if output:
                print(output, file=sys.stderr, end="" if output.endswith("\n") else "\n")
            successful = process.get_successful()
        except GLib.Error as error:
            output = str(error)
            successful = False
            print(f"Steam installation failed: {output}", file=sys.stderr)
        self.install_process = None

        if successful and steam_installed():
            self.show_final_page()
        else:
            self.show_install_error(output)

    def show_install_error(self, output):
        page = self._page()
        content = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=self._scale(24),
        )
        self._center(content)
        title = self._label(_("Steam® installation failed"), "title")
        title.add_css_class("error")
        content.append(title)
        content.append(self._label(install_error_message(output)))
        content.append(self._buttons(_("Exit [B]"), "b", _("Retry [A]"), "a"))
        page.set_center_widget(content)
        self._set_page(page, self.start_install, self.exit_requested)

    def show_final_page(self):
        page = self._page()
        if not steam_primed():
            page.set_center_widget(
                self._center(
                    self._label(
                        _(
                            "Steam is preparing. This may take a while...\n"
                        ),
                        "status",
                    )
                )
            )
        self._set_page(page)
        self.window.queue_draw()
        GLib.timeout_add(500, self.finish_ready)

    def finish_ready(self):
        self.result = 0
        self.quit()
        return GLib.SOURCE_REMOVE

    def exit_requested(self):
        self.result = USER_EXIT
        self.quit()


def main():
    application = Preflight()
    application.run(sys.argv)
    return application.result


if __name__ == "__main__":
    raise SystemExit(main())
