+		{
+			uint32_t drmFormat = source->drmFormat();
+			if ( drmFormat == DRM_FORMAT_INVALID )
+				drmFormat = VulkanFormatToDRM( source->format(), true );
+			if ( drmFormat == DRM_FORMAT_INVALID )
+				return false;
