+			CVulkanTexture::createFlags flags;
+			flags.bSampled = true;
+			flags.bTransferDst = true;
+			flags.bTransferSrc = true;
+			m_history = new CVulkanTexture;
+			return m_history->BInit( source->width(), source->height(), 1, drmFormat, flags );
