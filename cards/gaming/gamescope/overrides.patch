+			flags.bSampled = true;
+			flags.bStorage = true;
+			m_fsrIntermediate = new CVulkanTexture;
+			if ( !m_fsrIntermediate->BInit( width, height, 1, drmFormat, flags ) )
+			{
+				m_fsrIntermediate = nullptr;
+				return nullptr;
+			}
+			return m_fsrIntermediate;
+		}
