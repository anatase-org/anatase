From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Sat, 11 Jul 2026 19:27:51 +0200
Subject: xwayland: accept 24-bit SHM uploads to 32-bit drawables

---
 Xext/shm.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/Xext/shm.c b/Xext/shm.c
index 1eed91bc552e..bfacdb0d072e 100644
--- a/Xext/shm.c
+++ b/Xext/shm.c
@@ -540,7 +540,14 @@ ProcShmPutImage(ClientPtr client)
         length *= stuff->depth;
     }
     else if (stuff->format == ZPixmap) {
-        if (pDraw->depth != stuff->depth)
+        /*
+         * Chromium's software compositor can use a depth-24 XImage for an
+         * ARGB32 drawable.  Both formats have 32 bits per pixel, so allow
+         * this exact case and preserve the high byte supplied by the client.
+         */
+        if (pDraw->depth == 32 && stuff->depth == 24)
+            stuff->depth = 32;
+        else if (pDraw->depth != stuff->depth)
             return BadMatch;
         length = PixmapBytePad(stuff->totalWidth, stuff->depth);
     }

