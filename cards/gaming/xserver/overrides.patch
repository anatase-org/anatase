From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Sun, 23 Aug 2026 21:45:20 +0200
Subject: dri3: notify screen drivers of the client DRM device

DRI3 1.4 clients identify the DRM device used for a drawable with SetDRMDeviceInUse, but the server currently only validates and logs the request. Screen drivers therefore cannot make device-specific import decisions.

Extend dri3_screen_info to version 5 with an optional callback and invoke it after validating the request window. Existing drivers retain their current behavior.
---
 dri3/dri3.h         | 10 +++++++++-
 dri3/dri3_request.c | 11 ++++++++++-
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/dri3/dri3.h b/dri3/dri3.h
index 14f9a1efa76f..a4d3fafbb8a4 100644
--- a/dri3/dri3.h
+++ b/dri3/dri3.h
@@ -28,7 +28,7 @@
 #include <X11/extensions/dri3proto.h>
 #include <randrstr.h>
 
-#define DRI3_SCREEN_INFO_VERSION        4
+#define DRI3_SCREEN_INFO_VERSION        5
 
 extern RESTYPE dri3_syncobj_type;
 
@@ -117,6 +117,11 @@ typedef struct dri3_syncobj *(*dri3_import_syncobj_proc) (ClientPtr client,
                                                           XID id,
                                                           int fd);
 
+typedef void (*dri3_set_drm_device_in_use_proc) (ClientPtr client,
+                                                  ScreenPtr screen,
+                                                  uint32_t drm_major,
+                                                  uint32_t drm_minor);
+
 typedef struct dri3_screen_info {
     uint32_t                    version;
 
@@ -137,6 +142,9 @@ typedef struct dri3_screen_info {
     /* Version 4 */
     dri3_import_syncobj_proc    import_syncobj;
 
+    /* Version 5 */
+    dri3_set_drm_device_in_use_proc set_drm_device_in_use;
+
 } dri3_screen_info_rec, *dri3_screen_info_ptr;
 
 extern _X_EXPORT Bool
diff --git a/dri3/dri3_request.c b/dri3/dri3_request.c
index 98c37aa91289..ef623fcb5ca8 100644
--- a/dri3/dri3_request.c
+++ b/dri3/dri3_request.c
@@ -578,6 +578,7 @@ static int
 proc_dri3_set_drm_device_in_use(ClientPtr client)
 {
     REQUEST(xDRI3SetDRMDeviceInUseReq);
+    dri3_screen_priv_ptr dri3;
     WindowPtr window;
     int status;
 
@@ -587,7 +588,15 @@ proc_dri3_set_drm_device_in_use(ClientPtr client)
     if (status != Success)
         return status;
 
-    /* TODO Eventually we should use this information to have
+    dri3 = dri3_screen_priv(window->drawable.pScreen);
+    if (dri3 && dri3->info && dri3->info->version >= 5 &&
+        dri3->info->set_drm_device_in_use)
+        dri3->info->set_drm_device_in_use(client,
+                                          window->drawable.pScreen,
+                                          stuff->drmMajor,
+                                          stuff->drmMinor);
+
+    /* TODO Eventually we should also use this information to have
      * DRI3GetSupportedModifiers return device-specific modifiers, but for now
      * we will ignore it until multi-device support is more complete.
      * Otherwise we can't advertise support for DRI3 1.4.

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Sun, 23 Aug 2026 21:47:00 +0200
Subject: xwayland: reject cross-device NVIDIA DMA-BUF imports

On an NVIDIA eGPU rendering for an AMD-driven Xwayland screen, importing the client DMA-BUF eventually faults the NVIDIA producer with Xid 31. The fault also reproduces when the buffer is CPU-mapped or passed through for the compositor to import, while preserving synchronization without accessing the buffer is stable.

Track the DRM device reported by each DRI3 1.4 client. When that device uses the NVIDIA DRM driver and differs from the Xwayland render device, reject PixmapFromBuffers before establishing an attachment. Clients such as Steam can then select their safe system-compositor fallback. Imports from the Xwayland device and non-NVIDIA cross-device imports remain unchanged.
---
 hw/xwayland/xwayland-glamor-gbm.c | 61 ++++++++++++++++++++++++++++++-
 hw/xwayland/xwayland-screen.h     |  3 ++
 2 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/hw/xwayland/xwayland-glamor-gbm.c b/hw/xwayland/xwayland-glamor-gbm.c
index 05668b8e9558..2595c05f4624 100644
--- a/hw/xwayland/xwayland-glamor-gbm.c
+++ b/hw/xwayland/xwayland-glamor-gbm.c
@@ -37,6 +37,7 @@
 #include <sys/eventfd.h>
 #endif /* DRI3 */
 #include <sys/stat.h>
+#include <sys/sysmacros.h>
 #include <xf86drm.h>
 #include <drm_fourcc.h>
 #if defined(__linux__)
@@ -753,6 +754,52 @@ xwl_dri3_open_client(ClientPtr client,
 
     return Success;
 }
+
+static void
+xwl_dri3_set_drm_device_in_use(ClientPtr client, ScreenPtr screen,
+                               uint32_t drm_major, uint32_t drm_minor)
+{
+    struct xwl_screen *xwl_screen = xwl_screen_get(screen);
+    struct xwl_gbm_private *xwl_gbm = xwl_gbm_get(xwl_screen);
+    struct xwl_client *xwl_client = xwl_client_get(client);
+    drmDevicePtr device = NULL;
+    drmVersionPtr version = NULL;
+    struct stat render_stat;
+    int fd = -1;
+
+    if (xwl_client->drm_device_major == drm_major &&
+        xwl_client->drm_device_minor == drm_minor)
+        return;
+
+    xwl_client->drm_device_major = drm_major;
+    xwl_client->drm_device_minor = drm_minor;
+    xwl_client->reject_foreign_nvidia = FALSE;
