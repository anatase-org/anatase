#!/bin/bash
set -eo pipefail

efi_root=/boot/efi
efi_payload=/usr/lib/ludos/efi
sd_payload=/usr/lib/ludos/sd
boot_mount=$efi_root
source /usr/libexec/grub-boot-remount
payload_tmp=
cleanup() {
    if [ -n "$payload_tmp" ]; then
        rm -f -- "$payload_tmp" || true
    fi
    remount_boot_ro
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if [ ! -d "$efi_payload" ] && [ ! -d "$sd_payload" ]; then
    echo "missing Anatase EFI and SD payload directories" >&2
    exit 1
fi

if ! mountpoint -q "$efi_root"; then
    echo "EFI system partition is not mounted: $efi_root" >&2
    exit 1
fi

copy_file() {
    local source=$1 destination=$2
    cmp -s -- "$source" "$destination" && return 0

    remount_boot_rw
    mkdir -p -- "$(dirname -- "$destination")"
    # Flush a complete sibling file before replacing any boot asset.
    payload_tmp=$(mktemp "${destination}.XXXXXX")
    cp --no-preserve=mode,ownership,timestamps -- "$source" "$payload_tmp"
    sync "$payload_tmp"
    mv -fT -- "$payload_tmp" "$destination"
    payload_tmp=
    sync "$efi_root"
}

copy_payload() {
    local payload=$1 version=${2:-} source relative destination
    [ -d "$payload" ] || return 0

    if [ -n "$version" ] && cmp -s -- "$payload/$version" "$efi_root/$version"; then
        return 0
    fi

    while IFS= read -r -d '' source; do
        relative=${source#"${payload}/"}
        destination=${efi_root}/${relative}
        [ "$relative" = "$version" ] && continue
        if [ "$relative" = config.txt ] && { [ -e "$destination" ] || [ -L "$destination" ]; }; then
            # Keep the SD card's user configuration.
            continue
        fi
        copy_file "$source" "$destination"
    done < <(find "$payload" -type f -print0)
    wait "$!"

    # Publish the version only after every boot asset has been installed safely.
    if [ -n "$version" ] && [ -f "$payload/$version" ]; then
        copy_file "$payload/$version" "$efi_root/$version"
    fi
}

copy_payload "$efi_payload"
if [ -f "$efi_root/config.txt" ]; then
    copy_payload "$sd_payload" version.txt
fi
