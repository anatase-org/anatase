#!/bin/bash
set -eo pipefail

efi_root=/boot/efi
payload=/usr/lib/ludos/efi
boot_mount=$efi_root
source /usr/libexec/grub-boot-remount
uboot_tmp=
cleanup() {
    if [ -n "$uboot_tmp" ]; then
        rm -f -- "$uboot_tmp" || true
    fi
    remount_boot_ro
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if [ ! -d "$payload" ]; then
    echo "missing Anatase EFI payload directory: $payload" >&2
    exit 1
fi

if ! mountpoint -q "$efi_root"; then
    echo "EFI system partition is not mounted: $efi_root" >&2
    exit 1
fi

while IFS= read -r -d '' source; do
    relative=${source#"${payload}/"}
    destination=${efi_root}/${relative}
    if [ "$relative" = rpi-u-boot.bin ]; then
        # Conventional UEFI installs do not use the Raspberry Pi bootloader.
        [ -f "$destination" ] || continue
        if cmp -s -- "$source" "$destination"; then
            continue
        fi

        remount_boot_rw
        # Flush a complete sibling file before replacing the bootloader.
        uboot_tmp=$(mktemp "${destination}.XXXXXX")
        cp --no-preserve=mode,ownership,timestamps -- "$source" "$uboot_tmp"
        sync "$uboot_tmp"
        mv -fT -- "$uboot_tmp" "$destination"
        uboot_tmp=
        sync "$efi_root"
    elif [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
        # Preserve existing firmware configuration and unrelated EFI files.
        remount_boot_rw
        mkdir -p -- "$(dirname -- "$destination")"
        cp --no-preserve=mode,ownership,timestamps -- "$source" "$destination"
        sync "$efi_root"
    fi
done < <(find "$payload" -type f -print0)
