[Unit]
Description=Install extra EFI and SD boot files
After=local-fs.target
RequiresMountsFor=/boot/efi
ConditionDirectoryNotEmpty=|/usr/lib/ludos/efi
ConditionDirectoryNotEmpty=|/usr/lib/ludos/sd
ConditionPathIsMountPoint=/boot/efi

[Service]
Type=oneshot
ExecStart=/usr/libexec/grub-boot-extrafiles

[Install]
WantedBy=multi-user.target
