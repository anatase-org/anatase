[Unit]
Description=Disable system sleep on unsupported hardware
Documentation=man:systemd-sleep.conf(5)
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target systemd-logind.service
ConditionVirtualization=!container
# Alternative hardware matches; add further models with the same | prefix.
ConditionFirmware=|smbios-field(product_name $= "Raspberry Pi *")
ConditionFirmware=|smbios-field(product_name = NVIDIA_DGX_Spark)

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/install -D -m0644 /usr/lib/anatase/sleep-disabled.conf /run/systemd/sleep.conf.d/40-anatase-hardware.conf

[Install]
WantedBy=sysinit.target
