+fn ostree_ref_remote_name() -> String {
+    format!("bootc-local-testing-{}", std::process::id())
+}
+
+fn ostree_pull_url(repo_path: &Utf8PathBuf, source: &str, ostree_ref: &str) -> Result<String> {
+    let remote = ostree_ref_remote_name();
+    Command::new("ostree")
+        .args([
+            "--repo",
+            repo_path.as_str(),
+            "remote",
+            "add",
+            "--no-gpg-verify",
+            &remote,
+            source,
+        ])
+        .run_capture_stderr()
+        .with_context(|| format!("Adding temporary ostree remote {remote} => {source}"))?;
+
+    let remote_ref = format!("{remote}:{ostree_ref}");
+    let pull_result = Command::new("ostree")
+        .args(["--repo", repo_path.as_str(), "pull", &remote, ostree_ref])
+        .run_capture_stderr()
+        .with_context(|| format!("Pulling ostree ref {remote}:{ostree_ref}"));
+    let commit_result =
+        pull_result.and_then(|_| ostree_rev_parse(repo_path, std::slice::from_ref(&remote_ref)));
+
+    let delete_result = Command::new("ostree")
+        .args(["--repo", repo_path.as_str(), "remote", "delete", &remote])
+        .run_capture_stderr()
+        .with_context(|| format!("Deleting temporary ostree remote {remote}"));
+
+    let commit = commit_result?;
+    delete_result?;
+
+    Ok(commit)
+}
+
+fn ostree_pull_local(repo_path: &Utf8PathBuf, source: &str, ostree_ref: &str) -> Result<String> {
+    let source_repo = Utf8PathBuf::from(source);
+    let source_commit = ostree_rev_parse(&source_repo, &[ostree_ref.to_string()])?;
+    Command::new("ostree")
+        .args([
+            "--repo",
+            repo_path.as_str(),
+            "pull-local",
+            source,
+            ostree_ref,
+        ])
+        .run_capture_stderr()
+        .with_context(|| format!("Pulling local ostree ref {ostree_ref} from {source}"))?;
+    ostree_rev_parse(repo_path, &[ostree_ref.to_string(), source_commit])
+}
+
+fn ostree_rev_parse(repo_path: &Utf8PathBuf, refspecs: &[String]) -> Result<String> {
+    let mut last_error = None;
+    for refspec in refspecs {
+        let result = Command::new("ostree")
+            .args([
+                "--repo",
+                repo_path.as_str(),
+                "rev-parse",
+                "--single",
+                refspec,
+            ])
+            .run_get_string()
+            .with_context(|| format!("Resolving ostree ref {refspec}"));
+        match result {
+            Ok(commit) => return Ok(commit.trim().to_string()),
+            Err(e) => last_error = Some(e),
+        }
+    }
+    Err(last_error.unwrap_or_else(|| anyhow!("No ostree refspecs to resolve")))
+}
+
+/// Pull an ostree ref into an ostree repository and synthesize enough image-shaped
+/// state for bootc's staging code. This is intentionally a local-testing escape hatch;
+/// the returned digest is the ostree commit checksum formatted as an OCI digest.
+#[context("Pulling ostree ref")]
+pub(crate) async fn pull_ostree_ref(
+    repo_path: Utf8PathBuf,
+    source: String,
+    ostree_ref: String,
+) -> Result<Box<ImageState>> {
+    tokio::task::spawn_blocking(move || -> Result<Box<ImageState>> {
+        let commit = if std::path::Path::new(&source).exists() {
+            ostree_pull_local(&repo_path, &source, &ostree_ref)?
+        } else {
+            ostree_pull_url(&repo_path, &source, &ostree_ref)?
+        };
+
+        let manifest_digest = Digest::from_str(&format!("sha256:{commit}"))?;
+
+        Ok(Box::new(ImageState {
+            manifest_digest,
+            version: Some("ostree-ref".to_string()),
+            ostree_commit: commit,
+        }))
+    })
+    .await?
+}
+
+pub(crate) fn dummy_imgref_for_ostree_commit(commit: &str) -> ImageReference {
+    let short = commit.get(..12).unwrap_or(commit);
+    ImageReference {
+        signature: None,
+        transport: "registry".to_string(),
+        image: format!("localhost/bootc-ostree-ref:{short}"),
+    }
+}
