+/// Implementation of the local-testing `bootc switch --ostree-repo ... --ostree-ref ...` path.
+#[context("Switching to ostree ref")]
+async fn switch_ostree_ref(
+    opts: SwitchOpts,
+    storage: &Storage,
+    booted_ostree: &BootedOstree<'_>,
+) -> Result<()> {
+    ensure!(
+        !opts.mutate_in_place,
+        "--mutate-in-place is not supported with --ostree-ref"
+    );
+    ensure!(
+        !opts.unified_storage_exp,
+        "--experimental-unified-storage is not supported with --ostree-ref"
+    );
+    ensure!(
+        opts.ostree_repo.is_some() == opts.ostree_ref.is_some(),
+        "--ostree-repo and --ostree-ref must be used together"
+    );
+
+    let ostree_repo = opts.ostree_repo.expect("validated ostree repo");
+    let ostree_ref = opts.ostree_ref.expect("validated ostree ref");
+    let repo_path = storage.physical_root_path.join("ostree/repo");
+    let prog: ProgressWriter = opts.progress.try_into()?;
+    let fetched = crate::deploy::pull_ostree_ref(repo_path, ostree_repo, ostree_ref).await?;
+    let target = crate::deploy::dummy_imgref_for_ostree_commit(&fetched.ostree_commit);
+    let spec = RequiredHostSpec { image: &target };
+    let stateroot = booted_ostree.stateroot();
+    let from = MergeState::from_stateroot(storage, &stateroot)?;
+    crate::deploy::stage(storage, from, &fetched, &spec, prog.clone(), false).await?;
+
+    storage.update_mtime()?;
+
+    if opts.soft_reboot.is_some() {
+        let updated_host = crate::status::get_status(booted_ostree)?.1;
+        handle_staged_soft_reboot(booted_ostree, opts.soft_reboot, &updated_host)?;
+    }
+
+    if opts.apply {
+        crate::reboot::reboot()?;
+    }
+
+    Ok(())
+}
