#!/usr/bin/bash
set -euo pipefail

config_dir=/usr/lib/anatase/flatpak
extension_root=/var/lib/flatpak/extension
runtime_root=/var/lib/flatpak/runtime
state_dir=/run/anatase/flatpak
# DO NOT TOUCH THIS CASUALLY.
# This is the Flatpak-imported OSTree commit for the deterministic dummy
# runtime published in the Anatase OCI Flatpak remote. If it does not exactly
# match that remote, Discover will report org.anatase.Platform as updateable
# forever. Only change it when regenerating and uploading the dummy runtime and
# updating cards/base/atomic/flatpak/anatase-runtime-deploy in the same commit.
anatase_runtime_commit=45a3b20413966e9c9070ac7459c797175ae7a70dd424e1534c5e3128844a4bc8
anatase_runtime_oci_digest=45a3b20413966e9c9070ac7459c797175ae7a70dd424e1534c5e3128844a4bc8

register_extension() {
    local ref=$1
    local target=$2

    [ -d "$target" ] || return 0

    local link="$extension_root/$ref"
    mkdir -p "$(dirname "$link")"
    ln -snf "$target" "$link"
}

unregister_extension() {
    local ref=$1
    local target=$2
    local link="$extension_root/$ref"

    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
        rm -f "$link"
        rmdir -p "$(dirname "$link")" --ignore-fail-on-non-empty
    fi
}

register_runtime() {
    local ref=$1
    local target=$2
    local runtime_ref=${ref#runtime/}
    local deploy_dir="$state_dir/runtime/$runtime_ref"
    local mountpoint=$deploy_dir/files
    local overrides=$target/overrides
    local runtime_overrides="$state_dir/overrides/$runtime_ref"

    [ "$runtime_ref" != "$ref" ] || return 1
    [ -d "$target" ] || return 0
    [ -f "$target/metadata" ] || return 0
    [ -s "$target/deploy" ] || return 0

    if mountpoint -q "$mountpoint"; then
        umount "$mountpoint"
    fi
    rm -rf "$deploy_dir" "$runtime_overrides"
    install -dm0755 "$mountpoint"
    ln -snf "$target/metadata" "$deploy_dir/metadata"
    ln -snf "$target/deploy" "$deploy_dir/deploy"

    if [ -d "$overrides" ]; then
        install -dm0755 "$runtime_overrides"
        cp -a "$overrides"/. "$runtime_overrides"/
        mount -t overlay overlay -o "lowerdir=$runtime_overrides:/usr" "$mountpoint"
    else
        mount --bind /usr "$mountpoint"
    fi

    [ -e "$mountpoint" ] || return 0

    local deploy_base="$runtime_root/$runtime_ref"
    mkdir -p "$deploy_base"
    ln -snf "$deploy_dir" "$deploy_base/$anatase_runtime_commit"
    ln -snf "$anatase_runtime_commit" "$deploy_base/active"
}

unregister_runtime() {
    local ref=$1
    local target=$2
    local runtime_ref=${ref#runtime/}
    local deploy_dir="$state_dir/runtime/$runtime_ref"
    local deploy_base="$runtime_root/$runtime_ref"
    local active="$deploy_base/active"
    local deploy_link="$deploy_base/$anatase_runtime_commit"
    local mountpoint="$deploy_dir/files"
    local runtime_overrides="$state_dir/overrides/$runtime_ref"

    [ "$runtime_ref" != "$ref" ] || return 1

    if [ -L "$deploy_link" ] && {
        [ "$(readlink "$deploy_link")" = "$target" ] ||
        [ "$(readlink "$deploy_link")" = "$deploy_dir" ]
    }; then
        if [ -L "$active" ] && [ "$(readlink "$active")" = "$anatase_runtime_commit" ]; then
            rm -f "$active"
        fi
        rm -f "$deploy_link"
        rmdir -p "$deploy_base" --ignore-fail-on-non-empty
    fi

    if mountpoint -q "$mountpoint"; then
        umount "$mountpoint"
    fi
    rm -rf "$deploy_dir" "$runtime_overrides"
    rmdir -p "$(dirname "$deploy_dir")" --ignore-fail-on-non-empty
    rmdir -p "$(dirname "$runtime_overrides")" --ignore-fail-on-non-empty
}

cleanup_managed_links() {
    if [ -d "$extension_root" ]; then
        find "$extension_root" -type l -print | while read -r link; do
            target="$(readlink "$link")"
            if [[ "$target" == "$config_dir"/* ]]; then
                rm -f "$link"
                rmdir -p "$(dirname "$link")" --ignore-fail-on-non-empty
            fi
        done
    fi

    if [ -d "$runtime_root" ]; then
        find "$runtime_root" -mindepth 4 -maxdepth 4 -type l ! -name active -print | while read -r link; do
            target="$(readlink "$link")"
            if [[ "$target" == "$config_dir"/* || "$target" == "$state_dir"/* ]]; then
                mountpoint="$target/files"
                if mountpoint -q "$mountpoint"; then
                    umount "$mountpoint"
                fi

                active="$(dirname "$link")/active"
                if [ -L "$active" ] && [ "$(readlink "$active")" = "$(basename "$link")" ]; then
                    rm -f "$active"
                fi

                rm -f "$link"
                if [[ "$target" == "$state_dir"/* ]]; then
                    rm -rf "$target"
                fi
                rmdir -p "$(dirname "$link")" --ignore-fail-on-non-empty
            fi
        done
    fi
}

process_declarations() {
    local action=$1
    shopt -s nullglob

    for config in "$config_dir"/*.conf; do
        while read -r ref target extra; do
            case "${ref:-}" in
                ''|\#*) continue ;;
            esac

            if [ -z "${target:-}" ] || [ -n "${extra:-}" ]; then
                printf 'ERROR: invalid Anatase Flatpak declaration in %s: %s %s %s\n' \
                    "$config" "${ref:-}" "${target:-}" "${extra:-}" >&2
                continue
            fi

            case "$ref" in
                runtime/*/*/*)
                    if [ "$action" = start ]; then
                        register_runtime "$ref" "$target" || {
                            printf 'ERROR: invalid Anatase Flatpak runtime declaration in %s: %s %s\n' \
                                "$config" "$ref" "$target" >&2
                        }
                    else
                        unregister_runtime "$ref" "$target"
                    fi
                    ;;
                *)
                    if [ "$action" = start ]; then
                        register_extension "$ref" "$target"
                    else
                        unregister_extension "$ref" "$target"
                    fi
                    ;;
            esac
        done < "$config"
    done
}

case "${1:-start}" in
    start)
        [ -d "$config_dir" ] || exit 0

        mkdir -p "$extension_root"
        mkdir -p "$runtime_root"
        cleanup_managed_links
        process_declarations start
        ;;
    stop)
        [ -d "$config_dir" ] || exit 0

        process_declarations stop
        cleanup_managed_links
        ;;
    *)
        printf 'usage: %s [start|stop]\n' "$0" >&2
        exit 2
        ;;
esac
