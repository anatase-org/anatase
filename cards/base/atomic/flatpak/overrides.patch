+static void
+test_host_xdg_dirs (void)
+{
+  static const char *names[] = {
+    "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "XDG_STATE_HOME"
+  };
+  g_autoptr(FlatpakContext) context = flatpak_context_new ();
+  g_autoptr(FlatpakBwrap) bwrap = flatpak_bwrap_new (NULL);
+  g_autoptr(FlatpakExports) exports = flatpak_exports_new ();
+  g_autoptr(FlatpakExports) probe = flatpak_exports_new ();
+  g_autoptr(GError) error = NULL;
+  g_autofree char *root = g_build_filename (g_get_current_dir (), "host-xdg-test-XXXXXX", NULL);
+  g_auto(GStrv) paths = g_new0 (char *, G_N_ELEMENTS (names) + 1);
+  g_auto(GStrv) old_values = g_new0 (char *, G_N_ELEMENTS (names) + 1);
+
+  g_assert_nonnull (g_mkdtemp (root));
+  if (!flatpak_exports_add_path_expose (probe, FLATPAK_FILESYSTEM_MODE_READ_WRITE,
+                                        root, &error))
+    {
+      if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_NOT_MOUNTABLE_FILE))
+        {
+          g_test_skip ("Build directory is reserved by Flatpak");
+          g_assert_no_errno (rmdir (root));
+          return;
+        }
+      g_assert_no_error (error);
+    }
+
+  for (gsize i = 0; i < G_N_ELEMENTS (names); i++)
+    {
+      paths[i] = g_build_filename (root, names[i], NULL);
+      old_values[i] = g_strdup (g_getenv (names[i]));
+      g_setenv (names[i], paths[i], TRUE);
+    }
+
+  g_assert_true (flatpak_context_append_bwrap_filesystem (context, bwrap,
+                                                           "org.test.Hello", NULL,
+                                                           exports, NULL, FALSE,
+                                                           FLATPAK_CONTEXT_FEATURE_HOST_XDG_DIRS,
+                                                           &error));
+  g_assert_no_error (error);
+  for (gsize i = 0; i < G_N_ELEMENTS (names); i++)
+    {
+      g_assert_cmpstr (g_environ_getenv (bwrap->envp, names[i]), ==, paths[i]);
+      g_assert_cmpint (flatpak_exports_path_get_mode (exports, paths[i]), ==,
+                       FLATPAK_FILESYSTEM_MODE_READ_WRITE);
+    }
+
+  g_setenv ("XDG_CONFIG_HOME", "/usr", TRUE);
+  g_clear_pointer (&exports, flatpak_exports_free);
+  exports = flatpak_exports_new ();
+  g_clear_pointer (&bwrap, flatpak_bwrap_free);
+  bwrap = flatpak_bwrap_new (NULL);
+  g_assert_false (flatpak_context_append_bwrap_filesystem (context, bwrap,
+                                                            "org.test.Hello", NULL,
+                                                            exports, NULL, FALSE,
+                                                            FLATPAK_CONTEXT_FEATURE_HOST_XDG_DIRS,
+                                                            &error));
+  g_assert_nonnull (strstr (error->message, "Cannot expose host XDG_CONFIG_HOME"));
+
+  for (gsize i = 0; i < G_N_ELEMENTS (names); i++)
+    {
+      if (old_values[i] != NULL)
+        g_setenv (names[i], old_values[i], TRUE);
+      else
+        g_unsetenv (names[i]);
+      g_assert_no_errno (rmdir (paths[i]));
+    }
+  g_assert_no_errno (rmdir (root));
+}
