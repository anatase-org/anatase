From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Sat, 12 Sep 2026 19:17:31 +0200
Subject: Invalidate linker cache for mutable runtimes

---
 common/flatpak-run.c | 30 ++++++++++++++++++++++++++++++
 tests/test-run.sh    | 17 +++++++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/common/flatpak-run.c b/common/flatpak-run.c
index 4c05f266..e091e035 100644
--- a/common/flatpak-run.c
+++ b/common/flatpak-run.c
@@ -2842,13 +2842,42 @@ flatpak_context_load_for_deploy (FlatpakDeploy *deploy,
 static char *
 calculate_ld_cache_checksum (GBytes   *app_deploy_data,
                              GBytes   *runtime_deploy_data,
+                             int       runtime_fd,
                              const char *app_extensions,
                              const char *runtime_extensions)
 {
   g_autoptr(GChecksum) ld_so_checksum = g_checksum_new (G_CHECKSUM_SHA256);
+  glnx_autofd int runtime_ld_so_cache_path_fd = -1;
+  glnx_autofd int runtime_ld_so_cache_fd = -1;
+  g_autoptr(GBytes) runtime_ld_so_cache = NULL;
+
   if (app_deploy_data)
     g_checksum_update (ld_so_checksum, (guchar *) flatpak_deploy_data_get_commit (app_deploy_data), -1);
   g_checksum_update (ld_so_checksum, (guchar *) flatpak_deploy_data_get_commit (runtime_deploy_data), -1);
+
+  /* Normally the runtime commit is sufficient to identify its contents. Some
+   * system integrations, however, expose a mutable runtime tree behind a
+   * stable deploy ID. Include the runtime's input linker cache so that changes
+   * to the libraries it describes invalidate our generated cache too. */
+  runtime_ld_so_cache_path_fd = glnx_chaseat (runtime_fd, "etc/ld.so.cache",
+                                              GLNX_CHASE_RESOLVE_BENEATH |
+                                              GLNX_CHASE_MUST_BE_REGULAR,
+                                              NULL);
+  if (runtime_ld_so_cache_path_fd >= 0)
+    runtime_ld_so_cache_fd = glnx_fd_reopen (runtime_ld_so_cache_path_fd,
+                                             O_RDONLY, NULL);
+  if (runtime_ld_so_cache_fd >= 0)
+    runtime_ld_so_cache = glnx_fd_readall_bytes (runtime_ld_so_cache_fd, NULL, NULL);
+
+  if (runtime_ld_so_cache != NULL)
+    {
+      gconstpointer data;
+      gsize size;
+
+      data = g_bytes_get_data (runtime_ld_so_cache, &size);
+      g_checksum_update (ld_so_checksum, data, size);
+    }
+
   if (app_extensions)
     g_checksum_update (ld_so_checksum, (guchar *) app_extensions, -1);
   if (runtime_extensions)
@@ -3767,6 +3796,7 @@ flatpak_run_app (FlatpakDecomposed   *app_ref,
   if (use_ld_so_cache)
     {
       checksum = calculate_ld_cache_checksum (app_deploy_data, runtime_deploy_data,
+                                              runtime_fd,
                                               app_extensions, runtime_extensions);
       ld_so_fd = regenerate_ld_cache (bwrap->argv,
                                       bwrap->fds,
diff --git a/tests/test-run.sh b/tests/test-run.sh
index 1b1e4414..d851fbdf 100644
--- a/tests/test-run.sh
+++ b/tests/test-run.sh
@@ -89,6 +89,23 @@ assert_file_has_content hello_out '^Hello world, from a sandbox$'
 
 ok "hello"
 
+# A runtime is normally immutable and identified by its commit, but some
+# system integrations expose mutable runtime contents behind a stable deploy
+# ID. Ensure an updated runtime linker cache invalidates Flatpak's generated
+# linker cache in that case.
+runtime_ld_cache="$FL_DIR/runtime/org.test.Platform/$ARCH/stable/active/files/etc/ld.so.cache"
+app_ld_cache_dir="$TEST_DATA_DIR/home/.var/app/org.test.Hello/.ld.so"
+mkdir -p "$(dirname "$runtime_ld_cache")"
+printf 'runtime linker cache version 1\n' > "$runtime_ld_cache"
+run org.test.Hello > /dev/null
+first_ld_cache=$(readlink "$app_ld_cache_dir/active")
+printf 'runtime linker cache version 2\n' > "$runtime_ld_cache"
+run org.test.Hello > /dev/null
+second_ld_cache=$(readlink "$app_ld_cache_dir/active")
+assert_not_streq "$first_ld_cache" "$second_ld_cache"
+
+ok "runtime linker cache invalidates generated linker cache"
+
 # This should try and fail to run e.g. /usr/bin/--tmpfs, which will
 # exit with a nonzero status because there is no such executable.
 # It should not pass "--tmpfs /blah hello.sh" as bwrap options.

