@@ -179,6 +179,7 @@ flatpak_run_add_socket_args_environment (FlatpakBwrap         *bwrap,
   gboolean allow_wayland;
   gboolean inherit_wayland_socket;
   gboolean allow_x11;
+  gboolean unrestricted_x11;
 
   allow_wayland = (sockets & FLATPAK_CONTEXT_SOCKET_WAYLAND) != 0;
   inherit_wayland_socket = (sockets & FLATPAK_CONTEXT_SOCKET_INHERIT_WAYLAND_SOCKET) != 0;
@@ -187,8 +188,9 @@ flatpak_run_add_socket_args_environment (FlatpakBwrap         *bwrap,
                                 allow_wayland,
                                 inherit_wayland_socket);
 
-  allow_x11 = (sockets & FLATPAK_CONTEXT_SOCKET_X11) != 0;
-  flatpak_run_add_x11_args (bwrap, allow_x11, shares);
+  unrestricted_x11 = (sockets & FLATPAK_CONTEXT_SOCKET_X11_UNRESTRICTED) != 0;
+  allow_x11 = unrestricted_x11 || (sockets & FLATPAK_CONTEXT_SOCKET_X11) != 0;
+  flatpak_run_add_x11_args (bwrap, allow_x11, shares, unrestricted_x11);
 
   if (sockets & FLATPAK_CONTEXT_SOCKET_SSH_AUTH)
     {
diff --git a/common/flatpak-run-x11-private.h b/common/flatpak-run-x11-private.h
