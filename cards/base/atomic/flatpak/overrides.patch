 common/flatpak-context-private.h |  1 +
 common/flatpak-context.c         |  1 +
 common/flatpak-run-sockets.c     |  6 ++-
 common/flatpak-run-x11-private.h |  3 +-
 common/flatpak-run-x11.c         | 84 +++++++++++++++++++-------------
 5 files changed, 57 insertions(+), 38 deletions(-)

