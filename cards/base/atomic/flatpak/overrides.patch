From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Mon, 3 Aug 2026 02:18:58 +0200
Subject: add X11 passthrough permission

For certain microcompositors e.g., gamescope, and Steam to work together
within a Flatpak context, where one or both are in a Flatpak, they need
to be able to create propagate and propagate X11 sockets.

Specifically, under a normal Gamescope session, gamescope creates two
xWayland sockets, one for Steam and one for games. If Steam is running
within a Flatpak, currently it can only access the primary socket.
This is problematic as games will launch within it, and not have access
to the game xwayland session.

Therefore, add --socket=x11-passthrough, which propagates all x11
sockets from the host to the client.
---
 common/flatpak-context-private.h |  1 +
 common/flatpak-context.c         |  1 +
 common/flatpak-run-sockets.c     |  6 ++++--
 common/flatpak-run-x11-private.h |  3 ++-
 common/flatpak-run-x11.c         | 22 ++++++++++++++++++----
 portal/flatpak-portal.c          |  5 ++++-
 6 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/common/flatpak-context-private.h b/common/flatpak-context-private.h
index 56ce95734a26..0bf7874d4f3e 100644
--- a/common/flatpak-context-private.h
+++ b/common/flatpak-context-private.h
@@ -61,6 +61,7 @@ typedef enum {
   FLATPAK_CONTEXT_SOCKET_CUPS        = 1 << 8,
   FLATPAK_CONTEXT_SOCKET_GPG_AGENT   = 1 << 9,
   FLATPAK_CONTEXT_SOCKET_INHERIT_WAYLAND_SOCKET = 1 << 10,
+  FLATPAK_CONTEXT_SOCKET_X11_UNRESTRICTED       = 1 << 11,
 } FlatpakContextSockets;
 
 typedef enum {
diff --git a/common/flatpak-context.c b/common/flatpak-context.c
index def68fd24a75..2cf8664a8df0 100644
--- a/common/flatpak-context.c
+++ b/common/flatpak-context.c
@@ -67,6 +67,7 @@ const char *flatpak_context_sockets[] = {
   "cups",
   "gpg-agent",
   "inherit-wayland-socket",
+  "x11-passthrough",
   NULL
 };
 
diff --git a/common/flatpak-run-sockets.c b/common/flatpak-run-sockets.c
index 6580e3970a02..fc51c063ee63 100644
--- a/common/flatpak-run-sockets.c
+++ b/common/flatpak-run-sockets.c
@@ -179,6 +179,7 @@ flatpak_run_add_socket_args_environment (FlatpakBwrap         *bwrap,
   gboolean allow_wayland;
   gboolean inherit_wayland_socket;
   gboolean allow_x11;
+  gboolean unrestricted_x11;
 
   allow_wayland = (sockets & FLATPAK_CONTEXT_SOCKET_WAYLAND) != 0;
   inherit_wayland_socket = (sockets & FLATPAK_CONTEXT_SOCKET_INHERIT_WAYLAND_SOCKET) != 0;
@@ -187,8 +188,9 @@ flatpak_run_add_socket_args_environment (FlatpakBwrap         *bwrap,
                                 allow_wayland,
                                 inherit_wayland_socket);
 
-  allow_x11 = (sockets & FLATPAK_CONTEXT_SOCKET_X11) != 0;
-  flatpak_run_add_x11_args (bwrap, allow_x11, shares);
+  unrestricted_x11 = (sockets & FLATPAK_CONTEXT_SOCKET_X11_UNRESTRICTED) != 0;
+  allow_x11 = unrestricted_x11 || (sockets & FLATPAK_CONTEXT_SOCKET_X11) != 0;
+  flatpak_run_add_x11_args (bwrap, allow_x11, shares, unrestricted_x11);
 
   if (sockets & FLATPAK_CONTEXT_SOCKET_SSH_AUTH)
     {
diff --git a/common/flatpak-run-x11-private.h b/common/flatpak-run-x11-private.h
index 96da2e6ba4ea..d3741447de54 100644
--- a/common/flatpak-run-x11-private.h
+++ b/common/flatpak-run-x11-private.h
@@ -30,7 +30,8 @@ G_BEGIN_DECLS
 
 void flatpak_run_add_x11_args (FlatpakBwrap         *bwrap,
                                gboolean              allowed,
-                               FlatpakContextShares  shares);
+                               FlatpakContextShares  shares,
+                               gboolean              unrestricted);
 
 gboolean flatpak_run_parse_x11_display (const char  *display,
                                         int         *family,
diff --git a/common/flatpak-run-x11.c b/common/flatpak-run-x11.c
index 90931c2ea267..b6f2ca1d53cf 100644
--- a/common/flatpak-run-x11.c
+++ b/common/flatpak-run-x11.c
@@ -202,15 +202,20 @@ flatpak_run_parse_x11_display (const char  *display,
 void
 flatpak_run_add_x11_args (FlatpakBwrap         *bwrap,
                           gboolean              allowed,
-                          FlatpakContextShares  shares)
+                          FlatpakContextShares  shares,
+                          gboolean              unrestricted)
 {
   g_autofree char *x11_socket = NULL;
   const char *display;
   g_autoptr(GError) local_error = NULL;
 
-  /* Always cover /tmp/.X11-unix, that way we never see the host one in case
-   * we have access to the host /tmp. If you request X access we'll put the right
-   * thing in this anyway.
+  /* Cover /tmp/.X11-unix, that way we never see the host one in case we have
+   * access to the host /tmp. If you request X access we'll put the right thing
+   * in this anyway.
+   * 
+   * For specialized instances, such as Flatpak microcompositors, allow binding
+   * the host directory so that the application can consume all X11 sockets and
+   * create new ones as needed.
    *
    * We need to be a bit careful here, because there are two situations in
    * which potentially hostile processes have access to /tmp and could
@@ -229,6 +234,15 @@ flatpak_run_add_x11_args (FlatpakBwrap         *bwrap,
    *   /tmp/.X11-unix is already a mount point, meaning the app cannot
    *   rename or delete it.
    */
+  if (unrestricted) {
+    flatpak_bwrap_add_args(bwrap,
+                           "--bind", "/tmp/.X11-unix", "/tmp/.X11-unix",
+                           NULL);
+    // TODO: Handle xauth and perhaps using the default display attr
+    // from the host if not provided
+    return;
+  }
+
   flatpak_bwrap_add_args (bwrap,
                           "--tmpfs", "/tmp/.X11-unix",
                           NULL);
diff --git a/portal/flatpak-portal.c b/portal/flatpak-portal.c
index 03ba05aef9ea..1bfbb2c4fac4 100644
--- a/portal/flatpak-portal.c
+++ b/portal/flatpak-portal.c
@@ -971,13 +971,16 @@ handle_spawn (PortalFlatpak         *object,
         {
           if (sockets != NULL && g_strv_contains ((const char * const *) sockets, "wayland"))
             g_ptr_array_add (flatpak_argv, g_strdup ("--socket=wayland"));
+          if (sockets != NULL && g_strv_contains ((const char * const *) sockets, "x11-passthrough"))
+            g_ptr_array_add (flatpak_argv, g_strdup ("--socket=x11-passthrough"));
           if (sockets != NULL && g_strv_contains ((const char * const *) sockets, "fallback-x11"))
             g_ptr_array_add (flatpak_argv, g_strdup ("--socket=fallback-x11"));
           if (sockets != NULL && g_strv_contains ((const char * const *) sockets, "x11"))
             g_ptr_array_add (flatpak_argv, g_strdup ("--socket=x11"));
           if (shares != NULL && g_strv_contains ((const char * const *) shares, "ipc") &&
               sockets != NULL && (g_strv_contains ((const char * const *) sockets, "fallback-x11") ||
-                                  g_strv_contains ((const char * const *) sockets, "x11")))
+                                  g_strv_contains ((const char * const *) sockets, "x11") ||
+                                  g_strv_contains ((const char * const *) sockets, "x11-passthrough")))
             g_ptr_array_add (flatpak_argv, g_strdup ("--share=ipc"));
         }
       if (sandbox_flags & FLATPAK_SPAWN_SANDBOX_FLAGS_SHARE_SOUND)
