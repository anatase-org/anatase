+static gboolean
+flatpak_context_apply_host_xdg_dirs (FlatpakBwrap   *bwrap,
+                                     FlatpakExports *exports,
+                                     GError        **error)
+{
+  static const struct {
+    const char *name;
+    const char *default_path;
+  } dirs[] = {
+    { "XDG_CONFIG_HOME", ".config" },
+    { "XDG_DATA_HOME", ".local/share" },
+    { "XDG_CACHE_HOME", ".cache" },
+    { "XDG_STATE_HOME", ".local/state" },
+  };
+  g_auto(GStrv) paths = g_new0 (char *, G_N_ELEMENTS (dirs) + 1);
+
+  for (gsize i = 0; i < G_N_ELEMENTS (dirs); i++)
+    {
+      const char *configured = g_getenv (dirs[i].name);
+      g_autofree char *default_path = NULL;
+
+      if (configured == NULL || !g_path_is_absolute (configured))
+        {
+          default_path = g_build_filename (g_get_home_dir (), dirs[i].default_path, NULL);
+          configured = default_path;
+        }
+
+      paths[i] = flatpak_canonicalize_filename (configured);
+
+      if (g_mkdir_with_parents (paths[i], 0700) != 0)
+        return glnx_throw_errno_prefix (error, "Cannot create host %s directory %s",
+                                        dirs[i].name, paths[i]);
+
+      if (!flatpak_exports_add_path_expose (exports, FLATPAK_FILESYSTEM_MODE_READ_WRITE,
+                                            paths[i], error))
+        {
+          g_prefix_error (error, "Cannot expose host %s directory %s: ",
+                          dirs[i].name, paths[i]);
+          return FALSE;
+        }
+    }
+
+  for (gsize i = 0; i < G_N_ELEMENTS (dirs); i++)
+    flatpak_bwrap_set_env (bwrap, dirs[i].name, paths[i], TRUE);
+
+  return TRUE;
+}
