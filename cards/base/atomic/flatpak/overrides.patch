     "share/dbus-1/services",              /* D-Bus service files */
     "share/gnome-shell/search-providers", /* Search providers */
     "share/krunner/dbusplugins",          /* KDE krunner DBus plugins */
+    "share/kio/servicemenus",             /* KDE file manager service menus */
