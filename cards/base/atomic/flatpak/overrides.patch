diff --git a/common/flatpak-context.c b/common/flatpak-context.c
index 2cf8664a8df0..8ff017f29c81 100644
--- a/common/flatpak-context.c
+++ b/common/flatpak-context.c
@@ -4405,6 +4405,10 @@ flatpak_context_get_allowed_exports (FlatpakContext *context,
     {
       g_ptr_array_add (allowed_extensions, g_strdup (".desktop"));
     }
+  else if (strcmp (source_path, "share/kio/servicemenus") == 0)
+    {
+      g_ptr_array_add (allowed_extensions, g_strdup (".desktop"));
+    }
   else if (strcmp (source_path, "share/mime/packages") == 0)
     {
       g_ptr_array_add (allowed_extensions, g_strdup (".xml"));
