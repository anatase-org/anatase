     "share/gnome-shell/search-providers",  "../../..",
     "share/krunner/dbusplugins",           "../../..",
+    "share/kio/servicemenus",              "../../..",
     "share/mime/packages",                 "../../..",
     "share/metainfo",                      "../..",
     "bin",                                 "..",
diff --git a/tests/make-test-app.sh b/tests/make-test-app.sh
index 21f7d5bd5e48..adec709608d7 100755
--- a/tests/make-test-app.sh
+++ b/tests/make-test-app.sh
@@ -128,6 +128,29 @@ X-Plasma-DBusRunner-Service=org.test.Hello.KRunner
 X-Plasma-DBusRunner-Path=/org/test/Hello/KRunner
 EOF
 
+mkdir -p ${DIR}/files/share/kio/servicemenus
+cat > ${DIR}/files/share/kio/servicemenus/org.test.Hello.desktop <<EOF
+[Desktop Entry]
+Type=Service
+MimeType=text/plain;
+Actions=hello;
+X-KDE-Priority=TopLevel
+
+[Desktop Action hello]
+Name=Say hello
+Exec=hello.sh --service-menu %F
+EOF
+cat > ${DIR}/files/share/kio/servicemenus/dont-export.desktop <<EOF
+[Desktop Entry]
+Type=Service
+MimeType=text/plain;
+Actions=hello;
+
+[Desktop Action hello]
+Name=Do not export
+Exec=hello.sh %F
+EOF
+
 mkdir -p ${DIR}/files/share/icons/hicolor/64x64/apps
 cp $(dirname $0)/org.test.Hello.png ${DIR}/files/share/icons/hicolor/64x64/apps/${APP_ID}.png
 cp $(dirname $0)/org.test.Hello.png ${DIR}/files/share/icons/hicolor/64x64/apps/dont-export.png
diff --git a/tests/test-run.sh b/tests/test-run.sh
index 726184413d98..179a05f06a5c 100644
--- a/tests/test-run.sh
+++ b/tests/test-run.sh
@@ -52,6 +52,9 @@ assert_has_file $FL_DIR/exports/share/gnome-shell/search-providers/org.test.Hell
 assert_file_has_content $FL_DIR/exports/share/gnome-shell/search-providers/org.test.Hello.search-provider.ini "^DefaultDisabled=true$"
 assert_has_file $FL_DIR/exports/share/krunner/dbusplugins/org.test.Hello.desktop
 assert_file_has_content $FL_DIR/exports/share/krunner/dbusplugins/org.test.Hello.desktop "^X-KDE-PluginInfo-EnabledByDefault=false$"
+assert_has_file $FL_DIR/exports/share/kio/servicemenus/org.test.Hello.desktop
+assert_file_has_content $FL_DIR/exports/share/kio/servicemenus/org.test.Hello.desktop "^Exec=.*flatpak run --branch=stable --arch=$ARCH --command=hello\.sh --file-forwarding org\.test\.Hello --service-menu @@ %F @@$"
+assert_not_has_file $FL_DIR/exports/share/kio/servicemenus/dont-export.desktop
 assert_has_file $FL_DIR/exports/share/icons/hicolor/64x64/apps/org.test.Hello.png
 assert_not_has_file $FL_DIR/exports/share/icons/hicolor/64x64/apps/dont-export.png
 assert_has_file $FL_DIR/exports/share/icons/HighContrast/64x64/apps/org.test.Hello.png

