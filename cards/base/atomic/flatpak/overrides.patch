+# The host XDG directories can be outside HOME and must be mounted as well
+# as named in the sandbox environment.
+host_xdg_root="${TEST_DATA_DIR}/host-xdg"
+host_xdg_config="${host_xdg_root}/config"
+host_xdg_data="${host_xdg_root}/data"
+host_xdg_cache="${host_xdg_root}/cache"
+host_xdg_state="${host_xdg_root}/state"
+${FLATPAK} override --user --allow=host-xdg-dirs org.test.Hello
+FLATPAK_USER_DIR="$USERDIR" \
+XDG_CONFIG_HOME="$host_xdg_config" \
+XDG_DATA_HOME="$host_xdg_data" \
+XDG_CACHE_HOME="$host_xdg_cache" \
+XDG_STATE_HOME="$host_xdg_state" \
+run --command=sh org.test.Hello -c '
+  printf "%s\n" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"
+  touch "$XDG_CONFIG_HOME/from-sandbox" "$XDG_DATA_HOME/from-sandbox" \
+    "$XDG_CACHE_HOME/from-sandbox" "$XDG_STATE_HOME/from-sandbox"
+' > host-xdg-out
+printf '%s\n' "$host_xdg_config" "$host_xdg_data" "$host_xdg_cache" "$host_xdg_state" > host-xdg-expected
+diff -u host-xdg-expected host-xdg-out
+for dir in "$host_xdg_config" "$host_xdg_data" "$host_xdg_cache" "$host_xdg_state"; do
+  assert_has_file "$dir/from-sandbox"
+done
+
+FLATPAK_USER_DIR="$USERDIR" \
+XDG_CONFIG_HOME="$host_xdg_config" \
+XDG_DATA_HOME="$host_xdg_data" \
+XDG_CACHE_HOME="$host_xdg_cache" \
+XDG_STATE_HOME="$host_xdg_state" \
+run --disallow=host-xdg-dirs --command=sh org.test.Hello -c \
+  'printf "%s\n" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"' \
+  > private-xdg-out
+printf '%s\n' \
+  "$HOME/.var/app/org.test.Hello/config" \
+  "$HOME/.var/app/org.test.Hello/data" \
+  "$HOME/.var/app/org.test.Hello/cache" \
+  "$HOME/.var/app/org.test.Hello/.local/state" > private-xdg-expected
+diff -u private-xdg-expected private-xdg-out
+
+FLATPAK_USER_DIR="$USERDIR" XDG_CONFIG_HOME=/usr \
+  assert_fail run --command=sh org.test.Hello -c true
+${FLATPAK} override --user --reset org.test.Hello
+
+ok "host XDG directories feature and override"
