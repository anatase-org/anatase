From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Sat, 28 Jun 2025 23:04:30 +0200
Subject: add --socket=wayland-passthrough for Wayland

The security context of Wayland can cause DRM leasing to fail when it
comes to using VR devices, and gamescope communication to fail to its
wayland socket to fail. Therefore, add an insecure mode to allow
disabling the security context. In addition, while in that context,
avoid renaming the socket if possible.
---
 common/flatpak-context-private.h     | 1 +
 common/flatpak-context.c             | 1 +
 common/flatpak-run-sockets.c         | 7 +++++--
 common/flatpak-run-wayland-private.h | 3 ++-
 common/flatpak-run-wayland.c         | 8 +++++---
 5 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/common/flatpak-context-private.h b/common/flatpak-context-private.h
index 0bf7874d4f3e..84398fea365e 100644
--- a/common/flatpak-context-private.h
+++ b/common/flatpak-context-private.h
@@ -62,6 +62,7 @@ typedef enum {
   FLATPAK_CONTEXT_SOCKET_GPG_AGENT   = 1 << 9,
   FLATPAK_CONTEXT_SOCKET_INHERIT_WAYLAND_SOCKET = 1 << 10,
   FLATPAK_CONTEXT_SOCKET_X11_UNRESTRICTED       = 1 << 11,
+  FLATPAK_CONTEXT_SOCKET_WAYLAND_INSECURE       = 1 << 12,
 } FlatpakContextSockets;
 
 typedef enum {
diff --git a/common/flatpak-context.c b/common/flatpak-context.c
index 521d9b2d327c..898faff8899f 100644
--- a/common/flatpak-context.c
+++ b/common/flatpak-context.c
@@ -68,6 +68,7 @@ const char *flatpak_context_sockets[] = {
   "gpg-agent",
   "inherit-wayland-socket",
   "x11-passthrough",
+  "wayland-passthrough",
   NULL
 };
 
diff --git a/common/flatpak-run-sockets.c b/common/flatpak-run-sockets.c
index 2d8e91e16a76..266a99aeec7e 100644
--- a/common/flatpak-run-sockets.c
+++ b/common/flatpak-run-sockets.c
@@ -180,13 +180,16 @@ flatpak_run_add_socket_args_environment (FlatpakBwrap         *bwrap,
   gboolean inherit_wayland_socket;
   gboolean allow_x11;
   gboolean unrestricted_x11;
+  gboolean insecure_wayland;
 
-  allow_wayland = (sockets & FLATPAK_CONTEXT_SOCKET_WAYLAND) != 0;
+  insecure_wayland = (sockets & FLATPAK_CONTEXT_SOCKET_WAYLAND_INSECURE) != 0;
+  allow_wayland = insecure_wayland || (sockets & FLATPAK_CONTEXT_SOCKET_WAYLAND) != 0;
   inherit_wayland_socket = (sockets & FLATPAK_CONTEXT_SOCKET_INHERIT_WAYLAND_SOCKET) != 0;
   flatpak_run_add_wayland_args (bwrap,
                                 app_id, instance_id,
                                 allow_wayland,
-                                inherit_wayland_socket);
+                                inherit_wayland_socket,
+                                insecure_wayland);
 
   unrestricted_x11 = (sockets & FLATPAK_CONTEXT_SOCKET_X11_UNRESTRICTED) != 0;
   allow_x11 = unrestricted_x11 || (sockets & FLATPAK_CONTEXT_SOCKET_X11) != 0;
diff --git a/common/flatpak-run-wayland-private.h b/common/flatpak-run-wayland-private.h
