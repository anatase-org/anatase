[Unit]
Description=Register Anatase-managed Flatpak extensions
After=local-fs.target
Before=flatpak-system-helper.service anatase-flatpaks.service
RequiresMountsFor=/var/lib/flatpak

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/anatase-flatpak-extensions start
ExecStop=/usr/libexec/anatase-flatpak-extensions stop

[Install]
WantedBy=multi-user.target
