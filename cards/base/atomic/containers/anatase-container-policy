#!/usr/bin/python3
from __future__ import annotations

import copy
import json
from pathlib import Path


COSIGN_ROOT = "/usr/share/anatase/keys/anatase-cosign-root.pem"
COSIGN_IDENTITY = "cosign.anatase.org"
POLICY_SCOPES = ("i.anatase.org/anatase",)


def main() -> int:
    write_policy()
    return 0


def write_policy() -> None:
    path = Path("/etc/containers/policy.json")
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        policy = json.loads(path.read_text(encoding="utf-8"))
    else:
        policy = {"default": [{"type": "insecureAcceptAnything"}]}

    transports = policy.setdefault("transports", {})
    docker = transports.setdefault("docker", {})
    anatase_policy = [
        {
            "type": "sigstoreSigned",
            "pki": {
                "caRootsPath": COSIGN_ROOT,
                "subjectHostname": COSIGN_IDENTITY,
            },
            "signedIdentity": {"type": "matchRepository"},
        }
    ]
    for scope in POLICY_SCOPES:
        docker[scope] = copy.deepcopy(anatase_policy)

    policy_json = json.dumps(policy, indent=4, sort_keys=True) + "\n"
    path.write_text(policy_json, encoding="utf-8")


if __name__ == "__main__":
    raise SystemExit(main())
