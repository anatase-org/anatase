{
    "default": [
        {
            "type": "reject"
        }
    ],
    "transports": {
        "docker": {
            "i.anatase.org/anatase": [
                {
                    "pki": {
                        "caRootsPath": "/usr/share/anatase/keys/anatase-cosign-root.pem",
