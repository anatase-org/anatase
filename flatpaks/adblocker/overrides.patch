From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <git@antheas.dev>
Date: Fri, 3 Jul 2026 20:36:29 +0200
Subject: Build only enabled MV3 rulesets

---
 platform/mv3/make-rulesets.js | 16 ++--------------
 1 file changed, 2 insertions(+), 14 deletions(-)

diff --git a/platform/mv3/make-rulesets.js b/platform/mv3/make-rulesets.js
index ea8cab872..cdb420a14 100644
--- a/platform/mv3/make-rulesets.js
+++ b/platform/mv3/make-rulesets.js
@@ -266,20 +266,7 @@ async function fetchListFromCache(assetDetails) {
         return content;
     }
 
-    const context = {
-        env,
-        secret,
-        trustedPrefixes: [ 'https://ublockorigin.github.io/uAssets/filters/' ],
-    };
-
-    const text = await fetchList(context, assetDetails);
-    writeFile(`${cacheDir}/${platform}/${fname}`, text);
-
-    if ( Boolean(text) === false ) {
-        throw 'Filter list should not be empty';
-    }
-
-    return text;
+    throw 'Cached lists run only';
 }
 
 /******************************************************************************/
@@ -1183,6 +1170,7 @@ async function main() {
     );
 
     for ( const ruleset of rulesets ) {
+        if ( ruleset.enabled !== true ) { continue; }
         if ( ruleset.excludedPlatforms?.includes(platform) ) { continue; }
         await rulesetFromURLs(ruleset);
     }

