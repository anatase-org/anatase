@@ -201,6 +202,12 @@ void DarkModeFilter::ApplyFilterToImage(Image* image,
   DCHECK(image);
   DCHECK(flags);
 
+  // When the `AutoDarkModeSkipImages` feature is enabled, never apply dark mode
