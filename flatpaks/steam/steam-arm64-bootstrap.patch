--- a/bin_steam.sh
+++ b/bin_steam.sh
@@ -23,6 +23,13 @@
 }
 
 export STEAMSCRIPT_VERSION=1.0.0.87
+
+# flatpak enter strips HOME, but the native client needs it to find
+# the running client's token when forwarding commands.
+if [ -z "${HOME:-}" ]; then
+	unset HOME
+	export HOME=~
+fi
 
 # Set up domain for script localization
 export TEXTDOMAIN=steam
@@ -116,9 +123,10 @@
 
 function detect_platform()
 {
-	# Maybe be smarter someday
-	# Right now this is the only platform we have a bootstrap for, so hard-code it.
-	echo ubuntu12_32
+	case "$(uname -m)" in
+		aarch64) echo linuxarm64 ;;
+		*) echo ubuntu12_32 ;;
+	esac
 }
 
 function setup_variables()
@@ -138,6 +146,9 @@
 	LAUNCHSTEAMDIR="$(readlink -e -q "$STEAMDATALINK" || true)"
 	# Normally 'ubuntu12_32'
 	LAUNCHSTEAMPLATFORM="$(detect_platform)"
+	if [ "$LAUNCHSTEAMPLATFORM" = linuxarm64 ]; then
+		STEAMBOOTSTRAP=steamrtarm64/steam
+	fi
 	# Often in /usr/lib/steam
 	LAUNCHSTEAMBOOTSTRAPFILE="$bootstrapdir/bootstraplinux_$LAUNCHSTEAMPLATFORM.tar.xz"
 	if [ ! -f "$LAUNCHSTEAMBOOTSTRAPFILE" ]; then
@@ -229,7 +240,7 @@
 	# this script we assume that ~/.steam/steam and ~/.steam/root
 	# are the same: they only differ in developer use-cases which
 	# also bypass this script
-	local srt="${STEAM_RUNTIME_SCOUT:-"$data/ubuntu12_32/steam-runtime"}"
+	local srt="${STEAM_RUNTIME_SCOUT:-"$data/$LAUNCHSTEAMPLATFORM/steam-runtime"}"
 	local argv="$2"
 
 	if [[ -n "$data" && -x "$data/$STEAMBOOTSTRAP" ]]; then
@@ -243,6 +254,10 @@
 
 function forward_command_line()
 {
+	if [ "$LAUNCHSTEAMPLATFORM" = linuxarm64 ]; then
+		return 1
+	fi
+
 	if ! [ -p "$STEAMCONFIG/steam.pipe" ]; then
 		return 1
 	fi
@@ -308,6 +323,22 @@
 fi
 
 # go to the install directory and run the client
-cd "$LAUNCHSTEAMDIR"
+if [ "$LAUNCHSTEAMPLATFORM" = linuxarm64 ]; then
+	ln -fns "$LAUNCHSTEAMDIR" "$STEAMCONFIG/root"
+	ln -fns "$LAUNCHSTEAMDIR/linuxarm64" "$STEAMCONFIG/sdkarm64"
+	export LD_LIBRARY_PATH="$LAUNCHSTEAMDIR/steamrtarm64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
+	cd "$LAUNCHSTEAMDIR/steamrtarm64"
+	# We bypass steam.sh on ARM, so handle its update/restart status here.
+	while true; do
+		status=0
+		"$LAUNCHSTEAMDIR/$STEAMBOOTSTRAP" ${log_opened+-srt-logger-opened} "$@" || status=$?
+		if [ "$status" -ne 42 ]; then
+			exit "$status"
+		fi
+		log "Restarting Steam by request..."
+	done
+else
+	cd "$LAUNCHSTEAMDIR"
+fi
 
 exec "$LAUNCHSTEAMDIR/$STEAMBOOTSTRAP" ${log_opened+-srt-logger-opened} "$@"
