#!/bin/bash

anatase_sandbox_data_home="${XDG_DATA_HOME:-$HOME/.var/app/org.anatase.Steam/data}"
steam_home="$HOME"

# We are in a flatpak, we do not have
# fusermount setuid, appimage should extract instead
# hrun is not affected, it does not passthrough the variable
export APPIMAGE_EXTRACT_AND_RUN=1

flatpak_info=
for candidate in "${FLATPAK_INFO:-}" /.flatpak-info /run/flatpak-info; do
    [[ -n $candidate ]] || continue
    [[ -r $candidate ]] || continue
    flatpak_info=$candidate
    break
done

has_filesystem() {
    [[ -n $flatpak_info ]] || return 1
    sed -n '/^\[Context\]/,/^\[/{s/^filesystems=//p}' "$flatpak_info" \
        | tr ';' '\n' \
        | grep -Fx -- "$1" >/dev/null
}

if has_filesystem '~/.steam:create' && has_filesystem 'xdg-data/Steam:create'; then
    host_home="$HOME"
    host_xdg_data_home=
    if command -v flatpak-spawn >/dev/null 2>&1; then
        candidate_host_home="$(flatpak-spawn --host sh -c 'printf "%s" "$HOME"' 2>/dev/null || true)"
        case "$candidate_host_home" in
            /*) host_home=$candidate_host_home ;;
        esac
        host_xdg_data_home="$(flatpak-spawn --host sh -c 'printf "%s" "${XDG_DATA_HOME:-}"' 2>/dev/null || true)"
    fi
    case "$host_xdg_data_home" in
        /*) steam_data_home=$host_xdg_data_home ;;
        *) steam_data_home="$host_home/.local/share" ;;
    esac
    if mkdir -p "$host_home/.steam" "$steam_data_home/Steam" 2>/dev/null \
            && [[ -w $host_home/.steam ]] \
            && [[ -w $steam_data_home/Steam ]]; then
        steam_home="$host_home"
        export XDG_DATA_HOME="$steam_data_home"
    fi
fi

# Skip OOTB by using a baked registry.vdf with values set to 1
registry="$steam_home/.steam/registry.vdf"
if [[ ! -e $registry ]] && mkdir -p "${registry%/*}"; then
    cp /app/share/anatase/steam/registry.vdf "$registry"
fi

# Install Anatase's Steam Game Mode startup and suspend overrides.
# If Decky Animation Changer is installed ignore.
animation_changer="$HOME/homebrew/plugins/SDH-AnimationChanger/main.py"
if [[ ! -f $animation_changer ]]; then
    boot_movie=/app/share/anatase/steam/movies/anatase-boot.webm
    suspend_movie=/app/share/anatase/steam/movies/anatase-suspend.webm
    movies_dir="${XDG_DATA_HOME:-$HOME/.local/share}/Steam/config/uioverrides/movies"
    if mkdir -p "$movies_dir"; then
        startup_movies=(
            bigpicture_startup.webm
            deck_startup.webm
            oled_startup.webm
            steam_os_startup.webm
        )
        for movie in "${startup_movies[@]}"; do
            destination="$movies_dir/$movie"
            if ! cmp -s "$boot_movie" "$destination"; then
                cp "$boot_movie" "$destination"
            fi
        done

        suspend_movies=(
            deck-suspend-animation-from-throbber.webm
            oled-suspend-animation-from-throbber.webm
            steam_os_suspend_from_throbber.webm
            deck-suspend-animation.webm
            oled-suspend-animation.webm
            steam_os_suspend.webm
        )
        for movie in "${suspend_movies[@]}"; do
            destination="$movies_dir/$movie"
            if ! cmp -s "$suspend_movie" "$destination"; then
                cp "$suspend_movie" "$destination"
            fi
        done
    fi
fi

anatase_runtime_root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/anatase-steam"
if mkdir -p \
        "$anatase_runtime_root/applications" \
        "$anatase_runtime_root/icons" \
        "$anatase_runtime_root/bin"; then
    chmod 0700 \
        "$anatase_runtime_root" \
        "$anatase_runtime_root/applications" \
        "$anatase_runtime_root/icons" \
        "$anatase_runtime_root/bin"
    export ANATASE_STEAM_SANDBOX_DATA_HOME="$anatase_sandbox_data_home"
    export XDG_DATA_DIRS="$anatase_runtime_root:${XDG_DATA_DIRS:-/app/share:/usr/share}"
    /app/libexec/anatase-steam-applications \
        >"$anatase_runtime_root/rewrite.log" 2>&1 </dev/null &
fi

notification_pid=
stop_notification_daemon() {
    [[ -n $notification_pid ]] || return 0
    kill "$notification_pid" 2>/dev/null || true
    wait "$notification_pid" 2>/dev/null || true
    notification_pid=
}
trap stop_notification_daemon EXIT
trap 'exit 143' HUP INT TERM

if [[ ${XDG_SESSION_DESKTOP:-} = gamemode ]] && \
        command -v steam_notif_daemon >/dev/null 2>&1; then
    steam_notif_daemon &
    notification_pid=$!
fi

/app/bin/steam -steamdeck "$@"
